# Copy to `.env` in this folder. Never commit `.env`.

NODE_ENV=development

# Web (leave empty in local so Vite proxies /trpc and /auth)
VITE_API_URL=
VITE_DEMO_LOGIN_ENABLED=true

# API
PORT=8000
CLIENT_URL=http://localhost:5173
SESSION_SECRET=replace-with-16-plus-random-chars

# Demo login
DEMO_LOGIN_ENABLED=true
DEMO_USER_EMAIL=demo@checkon.app
DEMO_USER_NAME=Demo Watcher

# Google OAuth — leave blank until you add credentials in Google Cloud
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback
