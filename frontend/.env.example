# Copy to `.env` in this folder. Never commit `.env`.

NODE_ENV=development

# Web (leave empty in local so Vite proxies /trpc, /auth, and /backend)
VITE_API_URL=
VITE_DEMO_LOGIN_ENABLED=true
# Set false in production so dashboard data must come from AWS.
VITE_DEMO_DATA_ENABLED=true

# API
PORT=8000
CLIENT_URL=http://localhost:5173
# CDK CheckOnApi output, e.g. https://abc123.execute-api.us-east-1.amazonaws.com
AWS_BACKEND_API_URL=
SESSION_SECRET=replace-with-16-plus-random-chars
# DynamoDB table created by CheckOnData. Leave blank for local in-memory auth.
USERS_TABLE=
AWS_REGION=us-east-1
# 32+ random characters; changing this makes existing authenticator enrollments unreadable.
TOTP_ENCRYPTION_KEY=replace-with-32-plus-random-characters

# Demo login
DEMO_LOGIN_ENABLED=true
DEMO_USER_EMAIL=demo@checkon.app
DEMO_USER_NAME=Demo Watcher

# Google OAuth — leave blank until you add credentials in Google Cloud
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback
